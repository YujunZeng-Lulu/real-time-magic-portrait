# Copy this file to `.env` (same folder) and fill it in.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit it or paste its contents anywhere.

# ── LiveKit (real-time voice rooms) ───────────────────────────────────────
# https://cloud.livekit.io → your project → Settings → API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Spatius (the digital human) ───────────────────────────────────────────
# App ID + API key: https://app.spatius.ai/apps
# Avatar ID: your avatar in Spatius Studio (must belong to the same App)
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
# Raw PCM audio: works without installing the Opus library.
SPATIUS_AUDIO_FORMAT=pcm_s16le
# SPATIUS_REGION=us-west        # optional: us-west | ap-northeast | cn-beijing

# ── Brain (LLM) ───────────────────────────────────────────────────────────
# DeepSeek: cheap and strong at Chinese. https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Without a DeepSeek key, LiveKit Inference is used (billed to LiveKit):
LLM_MODEL=openai/gpt-4.1

# ── Ears (speech-to-text, via LiveKit Inference) ──────────────────────────
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=zh-HK             # Cantonese. Mandarin: zh-CN · English: en · mixed: multi

# ── Voice (text-to-speech) ────────────────────────────────────────────────
# azure | minimax | elevenlabs | inference
TTS_PROVIDER=azure

# Azure Speech (free F0 tier): https://portal.azure.com → create "Speech service"
# → Keys and Endpoint → KEY 1 + Location/Region (e.g. uksouth)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_VOICE=zh-HK-WanLungNeural  # Cantonese male. Mandarin: zh-CN-YunyeNeural
# AZURE_RATE=0.85                  # 0.5–2.0, lower = slower, older
# AZURE_PITCH=low                  # x-low | low | medium

# MiniMax (designed voices; needs pay-as-you-go API balance, not plan credits)
# MINIMAX_API_KEY=
# MINIMAX_VOICE_ID=                # from `python agent/design_voice.py`
# MINIMAX_SPEED=0.88
# MINIMAX_PITCH=0

# ElevenLabs (your own cloned voice)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Widget ────────────────────────────────────────────────────────────────
# Show / hide shortcut (Alt = ⌥ Option on Mac)
WIDGET_SHORTCUT=Control+Alt+G
# portrait = gold frame, black-and-white until you talk · plain = no frame
WIDGET_LOOK=portrait
